[Unit]
Description=Opt-in Docker startup sequencing, interface naming and orphan DHCP veth cleanup
Documentation=https://docs.docker.com/engine/network/drivers/bridge/
Wants=docker.service vnstat.service
After=docker.service vnstat.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/veth-manager --manager-config=/etc/veth-manager/manager.yaml --mode=primary-repair --mapping-file=/run/veth-manager/mappings.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=veth-manager
RuntimeDirectoryMode=0755
StateDirectory=veth-manager
StateDirectoryMode=0700
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/var/lib/vnstat
ProtectHome=true
PrivateTmp=true
# Do not enable PrivateNetwork or restrict namespace entry: setns needs host/netns access.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
